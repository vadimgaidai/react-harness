{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/session-skills.mjs" }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(general-purpose|react-feature-workflow:(block-builder|bug-fixer))$",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/session-skills.mjs" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill|Write|Edit",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/loop-guard.mjs" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill|Write|Edit",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/loop-guard.mjs" }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/format-on-edit.mjs" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/loop-guard.mjs" }
        ]
      }
    ]
  }
}
